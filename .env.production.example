# Copy to .env.production, fill in, then:
#   npx wrangler secret bulk .env.production --config wrangler.production.jsonc
# Each Basic Auth value must be username:password.
ADMIN_BASIC=zayar:replace-with-a-long-random-password
APP_BASIC=preview:replace-with-a-different-long-random-password
# Preview logins for other domains are set in the dashboard.
# APP_BASIC is only a fallback until a dashboard login is saved.
# Lets the dashboard add and remove domains. Create a custom API token with
# Zone > Zone > Read, Zone > Workers Routes > Edit and Zone > DNS > Edit,
# limited to the managed zone only.
CLOUDFLARE_API_TOKEN=replace-with-the-scoped-api-token
