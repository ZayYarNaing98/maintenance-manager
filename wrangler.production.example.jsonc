{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maintenance-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "maintenance.example.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "PROTECTED_APP",
      "service": "example-test-app"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POLICIES",
        "class_name": "DomainPolicy"
      },
      {
        "name": "REGISTRY",
        "class_name": "DomainRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DomainPolicy"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DomainRegistry"
      ]
    }
  ],
  "vars": {
    "ADMIN_HOST": "maintenance.example.com",
    "WORKER_NAME": "maintenance-manager",
    "ZONES": [
      "example.com"
    ],
    "APPS": [
      {
        "binding": "PROTECTED_APP",
        "worker": "example-test-app"
      }
    ],
    "DOMAINS": []
  }
}
